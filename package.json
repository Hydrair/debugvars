{
  "name": "debugvars",
  "displayName": "DebugVars",
  "license": "MIT",
  "author": "Michael Kainz",
  "description": "Enables the user to edit variables on-the-fly to start different debug configurations more quickly",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hydrair/debugvars.git"
  },
  "publisher": "hydrair",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "debug": [
        {
          "id": "extended",
          "name": "Debugging Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "extended",
        "contents": "No variables found. Add a \"variables\" object to your launch.json and reference its entries with ${config:launch.variables.Name}."
      }
    ],
    "commands": [
      {
        "command": "debugvars.editValue",
        "title": "Edit",
        "icon": {
          "light": "resources/light/edit.svg",
          "dark": "resources/dark/edit.svg"
        }
      },
      {
        "command": "debugvars.refresh",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "debugvars.editValue",
          "when": "viewItem == option",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "debugvars.refresh",
          "when": "view == extended",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "debugvars.editValue",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --yarn"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
